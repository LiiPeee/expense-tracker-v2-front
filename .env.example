# Google OAuth Client ID
# Gere em: https://console.cloud.google.com/ > APIs & Services > Credentials
# Adicione o domínio de produção em "Authorized JavaScript origins"
VITE_CLIENT_ID=your_google_oauth_client_id_here

# URL base da API (sem barra no final)
# Exemplo produção: https://api.meuapp.com/api
# Exemplo dev:      http://localhost:8080/api
VITE_API_URL=https://your-api-url.com/api
